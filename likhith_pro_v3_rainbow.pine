//@version=5
indicator("Likhith Pro System v3 — Rainbow Edition", overlay=true, max_labels_count=500, max_lines_count=200)

// ═══════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════
grp1 = "═══ RAINBOW SETTINGS ═══"
show_rainbow   = input.bool(true,  "Show Rainbow Lines",       group=grp1)
rainbow_src    = input.source(close, "Rainbow Source",         group=grp1)

grp2 = "═══ TRADE SETTINGS ═══"
mode    = input.string("Positional", "Trading Mode", options=["Intraday", "Positional", "Scalper"], group=grp2)
sl_pct  = input.float(2.0,  "Stop Loss %",  minval=0.5, maxval=10.0, step=0.5, group=grp2)
t1_pct  = input.float(3.0,  "Target 1 %",  minval=1.0, maxval=20.0, step=0.5, group=grp2)
t2_pct  = input.float(6.0,  "Target 2 %",  minval=1.0, maxval=30.0, step=0.5, group=grp2)
t3_pct  = input.float(10.0, "Target 3 %",  minval=2.0, maxval=50.0, step=1.0, group=grp2)

grp3 = "═══ PATTERN DETECTION ═══"
show_patterns  = input.bool(true, "Show Chart Patterns",       group=grp3)
show_candles   = input.bool(true, "Show Candle Patterns",      group=grp3)

// ═══════════════════════════════════════════════════════════════
// SECTION 1: 🌈 RAINBOW INDICATOR — 7 EMAs
// The Rainbow uses 7 EMAs. When all 7 line up shortest-above-longest
// = PERFECT BUY (all green). Reversed = PERFECT SELL (all red).
// Periods: 5, 10, 15, 20, 25, 30, 35
// ═══════════════════════════════════════════════════════════════
r1 = ta.ema(rainbow_src, 5)    // Line 1 — fastest (top in uptrend)
r2 = ta.ema(rainbow_src, 10)   // Line 2
r3 = ta.ema(rainbow_src, 15)   // Line 3
r4 = ta.ema(rainbow_src, 20)   // Line 4 — middle
r5 = ta.ema(rainbow_src, 25)   // Line 5
r6 = ta.ema(rainbow_src, 30)   // Line 6
r7 = ta.ema(rainbow_src, 35)   // Line 7 — slowest (bottom in uptrend)

// Rainbow alignment check
// PERFECT BULL = each faster EMA above slower EMA (r1>r2>r3>r4>r5>r6>r7)
rainbow_bull = r1 > r2 and r2 > r3 and r3 > r4 and r4 > r5 and r5 > r6 and r6 > r7
// PERFECT BEAR = reversed (r1<r2<r3<r4<r5<r6<r7)
rainbow_bear = r1 < r2 and r2 < r3 and r3 < r4 and r4 < r5 and r5 < r6 and r6 < r7

// How many lines are bullishly ordered (0–6 crossings = 0–6 score)
rainbow_score = (r1 > r2 ? 1 : 0) + (r2 > r3 ? 1 : 0) + (r3 > r4 ? 1 : 0) +
                (r4 > r5 ? 1 : 0) + (r5 > r6 ? 1 : 0) + (r6 > r7 ? 1 : 0)
// 6/6 = perfect bull, 0/6 = perfect bear, 3/6 = neutral/consolidation

// Dynamic coloring — green when bullish, red when bearish, yellow when mixed
r_col(line_val, next_val) =>
    line_val > next_val ? color.new(color.green, 20) : color.new(color.red, 20)

if show_rainbow
    plot(r1, "R1 EMA5",  color=r_col(r1,r2), linewidth=1)
    plot(r2, "R2 EMA10", color=r_col(r2,r3), linewidth=1)
    plot(r3, "R3 EMA15", color=r_col(r3,r4), linewidth=1)
    plot(r4, "R4 EMA20", color=r_col(r4,r5), linewidth=2)
    plot(r5, "R5 EMA25", color=r_col(r5,r6), linewidth=1)
    plot(r6, "R6 EMA30", color=r_col(r6,r7), linewidth=1)
    plot(r7, "R7 EMA35", color=color.new(color.orange, 0), linewidth=2)

// ═══════════════════════════════════════════════════════════════
// SECTION 2: CORE INDICATORS (from v2)
// ═══════════════════════════════════════════════════════════════

// — EMA 50 and 200 (trend anchors)
ema50  = ta.ema(close, 50)
ema200 = ta.ema(close, 200)
plot(ema50,  "EMA 50",  color=color.new(color.orange, 0), linewidth=2)
plot(ema200, "EMA 200", color=color.new(color.red, 0),    linewidth=2)

// — RSI
rsi        = ta.rsi(close, 14)
rsi_bull   = rsi >= 45 and rsi < 65
rsi_danger = rsi > 74
rsi_os     = rsi < 35

// — MACD
[macd_line, signal_line, hist] = ta.macd(close, 12, 26, 9)
macd_bull  = macd_line > signal_line
macd_cross = ta.crossover(macd_line, signal_line)

// — Supertrend
[supertrend, st_dir] = ta.supertrend(3.0, 10)
st_bull = st_dir < 0
st_bear = st_dir > 0
plot(st_bull ? supertrend : na, "ST+", color=color.green, linewidth=2)
plot(st_bear ? supertrend : na, "ST-", color=color.red,   linewidth=2)

// — ADX
adx_len   = 14
dmi_p     = ta.rma(math.max(high - high[1], 0), adx_len)
dmi_m     = ta.rma(math.max(low[1] - low, 0),   adx_len)
tr_v      = ta.rma(ta.tr(true), adx_len)
adx       = ta.rma(100 * math.abs(dmi_p/tr_v - dmi_m/tr_v) / (dmi_p/tr_v + dmi_m/tr_v), adx_len)
adx_ok    = adx > 20

// — Bollinger Bands
bb_basis  = ta.sma(close, 20)
bb_dev    = ta.stdev(close, 20)
bb_upper  = bb_basis + 2.0 * bb_dev
bb_lower  = bb_basis - 2.0 * bb_dev
bb_width  = (bb_upper - bb_lower) / bb_basis * 100
bb_sqz    = bb_width < ta.sma(bb_width, 20) * 0.85
p_up = plot(bb_upper, "BB+", color=color.new(color.purple, 70), linewidth=1)
p_dn = plot(bb_lower, "BB-", color=color.new(color.purple, 70), linewidth=1)
fill(p_up, p_dn, color=color.new(color.purple, 93))

// — VWAP
vwap_val   = ta.vwap(hlc3)
above_vwap = close > vwap_val
plot(vwap_val, "VWAP", color=color.new(color.teal, 0), linewidth=1, style=plot.style_circles)

// — Volume
vol_avg    = ta.sma(volume, 20)
high_vol   = volume > vol_avg * 1.5
spike_vol  = volume > vol_avg * 3.0

// — Gap detection
gap_up   = open > close[1] * 1.005
gap_down = open < close[1] * 0.995

// ═══════════════════════════════════════════════════════════════
// SECTION 3: 📊 SIGNAL SCORING SYSTEM (0–10 scale)
// Each condition adds points. 9-10 = PERFECT BUY.
// This is what makes this indicator different from generic ones.
// ═══════════════════════════════════════════════════════════════
score = 0
score := score + (rainbow_score >= 5 ? 2 : rainbow_score >= 3 ? 1 : 0)  // Rainbow: 0-2 pts
score := score + (rsi_bull             ? 2 : 0)                           // RSI healthy: 2 pts
score := score + (macd_bull            ? 1 : 0)                           // MACD bullish: 1 pt
score := score + (st_bull              ? 1 : 0)                           // Supertrend bull: 1 pt
score := score + (adx_ok               ? 1 : 0)                           // ADX strong: 1 pt
score := score + (high_vol or spike_vol? 1 : 0)                           // Volume: 1 pt
score := score + (above_vwap           ? 1 : 0)                           // Above VWAP: 1 pt
score := score + (close > ema50        ? 1 : 0)                           // Above EMA50: 1 pt
// Max possible = 11, cap at 10
score := math.min(score, 10)

// ═══════════════════════════════════════════════════════════════
// SECTION 4: 🎯 BUY / SELL SIGNALS — 4 TIERS
// ═══════════════════════════════════════════════════════════════

// ⭐⭐⭐ PERFECT BUY — Score 9-10 + Rainbow all green
perfect_buy = score >= 9 and
              rainbow_bull and
              not rsi_danger and
              not gap_up

// ⭐⭐ STRONG BUY — Score 7-8
strong_buy = score >= 7 and score < 9 and
             rainbow_score >= 4 and
             not rsi_danger and
             not gap_up and
             not perfect_buy

// ⭐ MODERATE BUY — Score 5-6
moderate_buy = score >= 5 and score < 7 and
               not rsi_danger and
               not perfect_buy and
               not strong_buy

// 🔴 PERFECT SELL — Rainbow all red + multiple conditions
perfect_sell = rainbow_bear and
               macd_line < signal_line and
               st_bear and
               rsi > 60

// 🟠 SELL SIGNAL — broader
sell_signal = (rsi_danger or close < r4) and
              macd_line < signal_line and
              st_bear and
              not perfect_sell

// ⚠️ DANGER / AVOID
danger = rsi > 74 and not (sell_signal or perfect_sell)

// Signal plots
plotshape(perfect_buy,  "PERFECT BUY", shape.labelup,   location.belowbar, color=color.new(color.lime, 0),    textcolor=color.black,  text="🌈 PERFECT\nBUY",   size=size.large)
plotshape(strong_buy,   "STRONG BUY",  shape.labelup,   location.belowbar, color=color.new(color.green, 10),  textcolor=color.white,  text="★ BUY",             size=size.normal)
plotshape(moderate_buy, "BUY",         shape.labelup,   location.belowbar, color=color.new(color.green, 30),  textcolor=color.white,  text="BUY",               size=size.small)
plotshape(perfect_sell, "PERFECT SELL",shape.labeldown, location.abovebar, color=color.new(color.maroon, 0),  textcolor=color.white,  text="🔴 PERFECT\nSELL",  size=size.large)
plotshape(sell_signal,  "SELL",        shape.labeldown, location.abovebar, color=color.new(color.red, 10),    textcolor=color.white,  text="SELL",              size=size.normal)
plotshape(danger,       "AVOID",       shape.labeldown, location.abovebar, color=color.new(color.orange, 0),  textcolor=color.white,  text="⚠ AVOID",           size=size.small)

// ═══════════════════════════════════════════════════════════════
// SECTION 5: 📐 CHART PATTERN DETECTION
// ═══════════════════════════════════════════════════════════════

// — DOUBLE BOTTOM (bullish reversal)
// Two lows at similar price level separated by a higher high
low1_db       = ta.lowest(low, 5)
low2_db       = ta.lowest(low, 10)[5]
high_between  = ta.highest(high, 10)[2]
double_bottom = show_patterns and
                math.abs(low1_db - low2_db) / low2_db < 0.02 and
                high_between > low1_db * 1.02 and
                close > high_between

// — DOUBLE TOP (bearish reversal)
high1_dt      = ta.highest(high, 5)
high2_dt      = ta.highest(high, 10)[5]
low_between   = ta.lowest(low, 10)[2]
double_top    = show_patterns and
                math.abs(high1_dt - high2_dt) / high2_dt < 0.02 and
                low_between < high1_dt * 0.98 and
                close < low_between

plotshape(double_bottom, "Double Bottom", shape.triangleup,   location.belowbar, color=color.new(color.aqua, 0),   textcolor=color.white, text="2B",  size=size.small)
plotshape(double_top,    "Double Top",    shape.triangledown, location.abovebar, color=color.new(color.fuchsia, 0),textcolor=color.white, text="2T",  size=size.small)

// ═══════════════════════════════════════════════════════════════
// SECTION 6: 🕯️ CANDLESTICK PATTERNS
// ═══════════════════════════════════════════════════════════════

body    = math.abs(close - open)
range_  = high - low
upper_w = high - math.max(close, open)
lower_w = math.min(close, open) - low

// Hammer — bullish reversal (long lower wick, small body at top)
hammer = show_candles and
         lower_w > body * 2.0 and
         upper_w < body * 0.5 and
         close > open and
         rsi < 50

// Shooting Star — bearish reversal (long upper wick, small body at bottom)
shooting_star = show_candles and
                upper_w > body * 2.0 and
                lower_w < body * 0.5 and
                close < open and
                rsi > 55

// Bullish Engulfing — strong reversal signal
bull_engulf = show_candles and
              close[1] < open[1] and
              close > open and
              open < close[1] and
              close > open[1] and
              body > body[1]

// Bearish Engulfing
bear_engulf = show_candles and
              close[1] > open[1] and
              close < open and
              open > close[1] and
              close < open[1] and
              body > body[1]

// Doji — indecision (body very small vs range)
doji = show_candles and body < range_ * 0.1

plotshape(hammer,       "Hammer",    shape.circle, location.belowbar, color=color.new(color.lime, 0),    textcolor=color.white, text="H",  size=size.tiny)
plotshape(shooting_star,"Shoot Star",shape.circle, location.abovebar, color=color.new(color.red, 0),     textcolor=color.white, text="SS", size=size.tiny)
plotshape(bull_engulf,  "Bull Eng",  shape.circle, location.belowbar, color=color.new(color.green, 0),   textcolor=color.white, text="BE", size=size.tiny)
plotshape(bear_engulf,  "Bear Eng",  shape.circle, location.abovebar, color=color.new(color.maroon, 0),  textcolor=color.white, text="BE", size=size.tiny)
plotshape(doji,         "Doji",      shape.cross,  location.belowbar, color=color.new(color.yellow, 0),  size=size.tiny)

// ═══════════════════════════════════════════════════════════════
// SECTION 7: AUTO STOP-LOSS + TARGET LINES
// ═══════════════════════════════════════════════════════════════
var float ep        = na
var line sl_l = na, t1_l = na, t2_l = na, t3_l = na

if perfect_buy or strong_buy
    ep := close
    if not na(sl_l)  then line.delete(sl_l)
    if not na(t1_l)  then line.delete(t1_l)
    if not na(t2_l)  then line.delete(t2_l)
    if not na(t3_l)  then line.delete(t3_l)
    sl  = ep * (1 - sl_pct  / 100)
    t1  = ep * (1 + t1_pct  / 100)
    t2  = ep * (1 + t2_pct  / 100)
    t3  = ep * (1 + t3_pct  / 100)
    sl_l := line.new(bar_index, sl, bar_index+25, sl, color=color.red,   width=1, style=line.style_dashed)
    t1_l := line.new(bar_index, t1, bar_index+25, t1, color=color.green, width=1, style=line.style_dashed)
    t2_l := line.new(bar_index, t2, bar_index+25, t2, color=color.lime,  width=1, style=line.style_dashed)
    t3_l := line.new(bar_index, t3, bar_index+25, t3, color=color.aqua,  width=1, style=line.style_dotted)
    label.new(bar_index+2, sl, "🛑 SL " + str.tostring(math.round(sl,2)),  color=color.new(color.red,80),   textcolor=color.red,   size=size.small)
    label.new(bar_index+2, t1, "🎯 T1 " + str.tostring(math.round(t1,2)),  color=color.new(color.green,80), textcolor=color.green, size=size.small)
    label.new(bar_index+2, t2, "🎯 T2 " + str.tostring(math.round(t2,2)),  color=color.new(color.lime,80),  textcolor=color.lime,  size=size.small)
    label.new(bar_index+2, t3, "🎯 T3 " + str.tostring(math.round(t3,2)),  color=color.new(color.aqua,80),  textcolor=color.aqua,  size=size.small)

// ═══════════════════════════════════════════════════════════════
// SECTION 8: BACKGROUND ZONES
// ═══════════════════════════════════════════════════════════════
bgcolor(perfect_buy                         ? color.new(color.lime,   93) : na, title="Perfect Buy zone")
bgcolor(rainbow_bull and not perfect_buy    ? color.new(color.green,  96) : na, title="Rainbow Bull zone")
bgcolor(rainbow_bear                        ? color.new(color.red,    96) : na, title="Rainbow Bear zone")
bgcolor(rsi > 74                            ? color.new(color.red,    90) : na, title="Danger RSI")
bgcolor(rsi < 35                            ? color.new(color.aqua,   92) : na, title="Oversold")
bgcolor(bb_sqz                              ? color.new(color.yellow, 94) : na, title="BB Squeeze")

// ═══════════════════════════════════════════════════════════════
// SECTION 9: 📋 ENHANCED DASHBOARD
// ═══════════════════════════════════════════════════════════════
var table dash = table.new(position.top_right, 2, 15,
     bgcolor=color.new(color.black, 72),
     border_color=color.new(color.gray, 50),
     border_width=1, frame_color=color.new(color.gray,30), frame_width=1)

score_col   = score >= 9 ? color.lime : score >= 7 ? color.green : score >= 5 ? color.yellow : color.red
rsi_col_    = rsi > 74 ? color.red : rsi < 35 ? color.lime : rsi >= 45 and rsi < 65 ? color.green : color.yellow
adx_col_    = adx > 25 ? color.lime : adx < 15 ? color.red : color.yellow
vol_col_    = spike_vol ? color.lime : high_vol ? color.green : color.gray
rb_col      = rainbow_bull ? color.lime : rainbow_bear ? color.red : color.yellow
sig_txt     = perfect_buy ? "🌈 PERFECT BUY" : strong_buy ? "★ STRONG BUY" : moderate_buy ? "BUY" : perfect_sell ? "🔴 PERFECT SELL" : sell_signal ? "SELL" : danger ? "⚠ AVOID" : "NEUTRAL"
sig_col_    = perfect_buy ? color.lime : strong_buy ? color.green : moderate_buy ? color.teal : perfect_sell ? color.maroon : sell_signal ? color.red : danger ? color.orange : color.gray
rsi_txt     = rsi > 74 ? "⚠ DANGER" : rsi >= 65 ? "CAUTION" : rsi >= 45 ? "✓ HEALTHY" : rsi < 35 ? "↑ OVERSOLD" : "NEUTRAL"
rb_txt      = rainbow_bull ? "🟢 ALL GREEN " + str.tostring(rainbow_score) + "/6" : rainbow_bear ? "🔴 ALL RED " + str.tostring(rainbow_score) + "/6" : "MIXED " + str.tostring(rainbow_score) + "/6"

if barstate.islast
    table.cell(dash, 0, 0,  "LIKHITH PRO v3",         text_color=color.white,  text_size=size.small, bgcolor=color.new(color.navy,30))
    table.cell(dash, 1, 0,  mode,                      text_color=color.yellow, text_size=size.small, bgcolor=color.new(color.navy,30))
    table.cell(dash, 0, 1,  "SIGNAL",                  text_color=color.white,  text_size=size.small)
    table.cell(dash, 1, 1,  sig_txt,                   text_color=sig_col_,     text_size=size.small)
    table.cell(dash, 0, 2,  "SCORE",                   text_color=color.white,  text_size=size.small)
    table.cell(dash, 1, 2,  str.tostring(score) + "/10", text_color=score_col,  text_size=size.small)
    table.cell(dash, 0, 3,  "🌈 RAINBOW",              text_color=color.white,  text_size=size.small)
    table.cell(dash, 1, 3,  rb_txt,                    text_color=rb_col,       text_size=size.small)
    table.cell(dash, 0, 4,  "RSI (14)",                text_color=color.white,  text_size=size.small)
    table.cell(dash, 1, 4,  str.tostring(math.round(rsi,1)) + " " + rsi_txt, text_color=rsi_col_, text_size=size.small)
    table.cell(dash, 0, 5,  "ADX (Trend)",             text_color=color.white,  text_size=size.small)
    table.cell(dash, 1, 5,  str.tostring(math.round(adx,1)) + (adx>25?" STRONG":adx<15?" WEAK":" MED"), text_color=adx_col_, text_size=size.small)
    table.cell(dash, 0, 6,  "Supertrend",              text_color=color.white,  text_size=size.small)
    table.cell(dash, 1, 6,  st_bull?"BULL ↑":"BEAR ↓", text_color=st_bull?color.lime:color.red, text_size=size.small)
    table.cell(dash, 0, 7,  "MACD",                    text_color=color.white,  text_size=size.small)
    table.cell(dash, 1, 7,  macd_bull?"BULL ↑":"BEAR ↓", text_color=macd_bull?color.lime:color.red, text_size=size.small)
    table.cell(dash, 0, 8,  "VWAP",                    text_color=color.white,  text_size=size.small)
    table.cell(dash, 1, 8,  above_vwap?"ABOVE ↑":"BELOW ↓", text_color=above_vwap?color.lime:color.red, text_size=size.small)
    table.cell(dash, 0, 9,  "EMA 50/200",              text_color=color.white,  text_size=size.small)
    table.cell(dash, 1, 9,  close>ema50 and close>ema200?"ABOVE BOTH":close>ema50?"ABOVE 50":"BELOW ✗", text_color=close>ema200?color.lime:close>ema50?color.yellow:color.red, text_size=size.small)
    table.cell(dash, 0, 10, "Volume",                  text_color=color.white,  text_size=size.small)
    table.cell(dash, 1, 10, spike_vol?"🔥 SPIKE":high_vol?"HIGH ✓":"NORMAL", text_color=vol_col_, text_size=size.small)
    table.cell(dash, 0, 11, "BB Squeeze",              text_color=color.white,  text_size=size.small)
    table.cell(dash, 1, 11, bb_sqz?"⚡ YES — BIG MOVE":"NO", text_color=bb_sqz?color.yellow:color.gray, text_size=size.small)
    table.cell(dash, 0, 12, "Gap",                     text_color=color.white,  text_size=size.small)
    table.cell(dash, 1, 12, gap_up?"⚠ GAP UP":gap_down?"⚠ GAP DOWN":"NONE", text_color=gap_up or gap_down?color.orange:color.gray, text_size=size.small)
    table.cell(dash, 0, 13, "Patterns",                text_color=color.white,  text_size=size.small)
    table.cell(dash, 1, 13, double_bottom?"2-BOTTOM ↑":double_top?"2-TOP ↓":hammer?"HAMMER":shooting_star?"SHOOT★":bull_engulf?"BULL ENG":bear_engulf?"BEAR ENG":doji?"DOJI":"—", text_color=double_bottom or hammer or bull_engulf?color.lime:double_top or shooting_star or bear_engulf?color.red:color.gray, text_size=size.small)
    table.cell(dash, 0, 14, "SL / T1 / T2",           text_color=color.white,  text_size=size.tiny)
    table.cell(dash, 1, 14, not na(ep) ? str.tostring(math.round(ep*(1-sl_pct/100),1))+" / "+str.tostring(math.round(ep*(1+t1_pct/100),1))+" / "+str.tostring(math.round(ep*(1+t2_pct/100),1)) : "—", text_color=color.gray, text_size=size.tiny)
